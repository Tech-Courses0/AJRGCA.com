import Link from 'next/link'
import clsx from 'clsx'

interface ButtonProps {
  children: React.ReactNode
  href?: string
  variant?: 'primary' | 'secondary' | 'ghost'
  className?: string
  onClick?: () => void
  type?: 'button' | 'submit'
}

export default function Button({
  children,
  href,
  variant = 'primary',
  className,
  onClick,
  type = 'button',
}: ButtonProps) {
  const base =
    'inline-flex items-center justify-center text-[0.78rem] font-semibold tracking-[0.08em] uppercase transition-all duration-200 cursor-pointer no-underline'

  const variants = {
    primary: 'bg-[var(--ink)] text-white border-2 border-[var(--ink)] px-8 py-3.5 hover:bg-white hover:text-[var(--ink)]',
    secondary: 'bg-transparent text-[var(--ink)] border-2 border-[var(--border-dark)] px-8 py-3.5 hover:border-[var(--ink)]',
    ghost: 'bg-transparent text-[var(--accent)] border-2 border-[var(--accent)] px-8 py-3.5 hover:bg-[var(--accent)] hover:text-white',
  }

  const classes = clsx(base, variants[variant], className)

  if (href) {
    return (
      <Link href={href} className={classes}>
        {children}
      </Link>
    )
  }

  return (
    <button type={type} onClick={onClick} className={classes}>
      {children}
    </button>
  )
}