# Resend — leave RESEND_API_KEY unset locally and the API route just
# console.logs what it would send (see app/api/contact/route.ts).
RESEND_API_KEY=

# Sender address; must be on a Resend-verified domain. Falls back to
# onboarding@resend.dev (dev/smoke-test only — cannot deliver to arbitrary
# inboxes like contact@ajrgca.com until ajrgca.com's DNS is verified in Resend).
RESEND_FROM="AJRG and Associates <contact@ajrgca.com>"

# Inbox that receives submissions. Defaults to config/site.ts's site.email if unset.
CONTACT_TO_EMAIL=contact@ajrgca.com

# Neon Postgres connection string. Auto-set by Vercel once a Neon store is
# attached (Storage tab). For local dev: `vercel env pull .env.local`.
DATABASE_URL=

# Google Calendar — creates a real Meet link when a video-call consultation is
# confirmed. From Google Cloud Console: create an OAuth 2.0 Client ID (Web
# application), enable the Calendar API, and add
# https://ajrgca.com/api/google/callback (and http://localhost:3001/api/google/callback
# for local dev) as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret gating the one-time /api/google/connect setup link (there's no
# admin login system — this is the only thing standing between a stranger and
# linking their own Google account to the firm's calendar). Set to any random
# string, then visit /api/google/connect?key=<this value> once to connect.
ADMIN_SECRET=
