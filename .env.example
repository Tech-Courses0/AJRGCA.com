# Inbox that receives all contact and booking notifications. Email is sent
# through the Google account connected at /admin/calendar. Defaults to
# config/site.ts's deliveryEmail if unset.
DESTINATION_EMAIL=ajrgandassociates@gmail.com

# Neon Postgres connection string. Auto-set by Vercel once a Neon store is
# attached (Storage tab). For local dev: `vercel env pull .env.local`.
DATABASE_URL=

# Google Gmail + Calendar — sends form emails and creates a real Meet link when
# a video-call consultation is confirmed. In Google Cloud Console, enable the
# Gmail API and Calendar API, create an OAuth 2.0 Client ID (Web application), and add
# https://ajrgcacom.vercel.app/api/google/callback (and
# http://localhost:3001/api/google/callback for local dev) as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Credentials gating /admin/login (the visual editor and Calendar settings) —
# there's no user-account system, just this one username/password pair.
# EDITOR_SECRET is also the value stored in the auth cookie.
EDITOR_USERNAME=
EDITOR_SECRET=

# Vercel Blob store token for the editor's image uploads (Storage tab -> Blob,
# auto-set once attached). If unset, local dev falls back to writing uploaded
# images into public/uploads/ instead.
BLOB_READ_WRITE_TOKEN=

# Mirrors each Publish to a GitHub commit (content/site-content.json), labeled
# with the change message typed in the editor — gives content real git
# history/rollback on top of the DB. Optional: publish still works without
# these, it just skips the GitHub commit. GITHUB_TOKEN needs `repo` (or
# fine-grained "Contents: Read and write") on GITHUB_REPO.
GITHUB_TOKEN=
GITHUB_REPO=Tech-Courses0/AJRGCA.com
