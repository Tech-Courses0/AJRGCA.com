# Gmail is the primary sender after Google is connected in the editor.
# Resend is an optional independent fallback; its sender domain must be verified.
RESEND_API_KEY=
RESEND_FROM="AJRG and Associates <contact@ajrgca.com>"

# Inbox that receives submissions. Defaults to config/site.ts when unset.
CONTACT_TO_EMAIL=contact@ajrgca.com

# Neon/Postgres connection string. Run scripts/init-db.sql once against it.
DATABASE_URL=

# Google OAuth powers Gmail sending plus Calendar/Meet. Enable the Gmail and
# Calendar APIs, create a Web OAuth client, and authorize the exact public
# https://your-domain.example/api/google/callback URL. Add the localhost
# callback separately when developing locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional From header override. Leave empty to use the connected Gmail account.
MAIL_FROM=

# Credentials gating /admin/login (the editor and Google settings). The secret
# signs a short-lived HttpOnly session; its raw value is not stored in the cookie.
EDITOR_USERNAME=
EDITOR_SECRET=

# Vercel Blob token for production image uploads. On a VPS, uploads fall back
# to public/uploads, which must be persistent and writable by the service user.
BLOB_READ_WRITE_TOKEN=

# Optional GitHub mirror for visual-editor publishes.
GITHUB_TOKEN=
GITHUB_REPO=Tech-Courses0/AJRGCA.com
